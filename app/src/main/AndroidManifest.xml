<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage/media permissions: the on-device library is entirely
         Storage Access Framework (SAF) based, needing no broad runtime grant.
         INTERNET is the one exception: it's used only to reach an SMB
         share the user explicitly connects to on their own local network,
         never anything beyond that. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="RetroTube"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.RetroTube"
        android:supportsRtl="true">

        <activity
            android:name=".LibraryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EffectSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".VideoMetadataActivity"
            android:exported="false" />

        <activity
            android:name=".SourcesActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelEditorActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelDetailActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelPickVideosActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelPickLocalFolderActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelPickSmbFolderActivity"
            android:exported="false" />

        <activity
            android:name=".BucketContentActivity"
            android:exported="false" />

        <activity
            android:name=".ShowDetailActivity"
            android:exported="false" />

        <activity
            android:name=".SeasonEpisodesActivity"
            android:exported="false" />

        <activity
            android:name=".MovieDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MovieEditInfoActivity"
            android:exported="false" />

        <activity
            android:name=".SourceEditInfoActivity"
            android:exported="false" />

        <activity
            android:name=".WifiImportActivity"
            android:exported="false" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RetroTube.Player" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
