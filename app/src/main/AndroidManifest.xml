<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage/media permissions: the on-device library is entirely
         Storage Access Framework (SAF) based, needing no broad runtime grant.
         INTERNET is the one exception: it's used only to reach an SMB
         share the user explicitly connects to on their own local network,
         never anything beyond that. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="RetroTube"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.RetroTube"
        android:supportsRtl="true">

        <activity
            android:name=".LibraryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EffectSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".VideoMetadataActivity"
            android:exported="false" />

        <activity
            android:name=".NetworkSharesActivity"
            android:exported="false" />

        <activity
            android:name=".CollectionEditActivity"
            android:exported="false" />

        <activity
            android:name=".TvSetupActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelEditorActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelDetailActivity"
            android:exported="false" />

        <activity
            android:name=".TvChannelPickVideosActivity"
            android:exported="false" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RetroTube.Player" />

    </application>
</manifest>
