<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/retro_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/retro_teal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/folderArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/folder_poster_background"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="34sp"
            android:alpha="0.55"
            app:layout_constraintTop_toTopOf="@id/folderArt"
            app:layout_constraintBottom_toBottomOf="@id/folderArt"
            app:layout_constraintStart_toStartOf="@id/folderArt"
            app:layout_constraintEnd_toEndOf="@id/folderArt"
            app:layout_constraintVertical_bias="0.4" />

        <View
            android:id="@+id/folderScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/poster_scrim"
            app:layout_constraintTop_toTopOf="@id/folderArt"
            app:layout_constraintBottom_toBottomOf="@id/folderArt"
            app:layout_constraintStart_toStartOf="@id/folderArt"
            app:layout_constraintEnd_toEndOf="@id/folderArt"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintHeight_percent="0.4" />

        <TextView
            android:id="@+id/removeFolderButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/poster_icon_background"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/folderArt"
            app:layout_constraintStart_toStartOf="@id/folderArt" />

        <TextView
            android:id="@+id/folderName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:textColor="@android:color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="@id/folderArt"
            app:layout_constraintStart_toStartOf="@id/folderArt"
            app:layout_constraintEnd_toEndOf="@id/folderArt" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
