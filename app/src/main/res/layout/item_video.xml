<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/retro_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/retro_teal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/videoThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="@color/thumbnail_placeholder"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/videoMenuButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp"
            android:text="⋮"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/poster_icon_background"
            app:layout_constraintTop_toTopOf="@id/videoThumbnail"
            app:layout_constraintStart_toStartOf="@id/videoThumbnail" />

        <TextView
            android:id="@+id/presetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp"
            android:background="@drawable/badge_background"
            android:textColor="@color/retro_teal"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toTopOf="@id/videoThumbnail"
            app:layout_constraintEnd_toEndOf="@id/videoThumbnail" />

        <View
            android:id="@+id/progressBarTrack"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@color/progress_track"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/videoThumbnail"
            app:layout_constraintStart_toStartOf="@id/videoThumbnail"
            app:layout_constraintEnd_toEndOf="@id/videoThumbnail" />

        <View
            android:id="@+id/progressBarFill"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@drawable/progress_bar_fill"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/videoThumbnail"
            app:layout_constraintStart_toStartOf="@id/videoThumbnail" />

        <TextView
            android:id="@+id/videoLocationHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/retro_teal"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="start"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/videoThumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/videoName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/retro_text_primary"
            android:textSize="14.5sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/videoLocationHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
