<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:background="@color/retro_surface"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/navLibraryTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navLibraryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_grid_view"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/navLibraryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_tab_library"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navTvTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navTvIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tv"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/navTvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_tab_tv"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSourcesTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/navSourcesIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_wifi"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/navSourcesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_tab_sources"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
