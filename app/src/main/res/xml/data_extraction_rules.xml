<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules. The Keystore-backed master key
  that encrypts retrotube_network_shares.xml (see NetworkShareRepository) is
  never itself part of a backup or device to device transfer; only the
  ciphertext would be restored, onto a new key that can't decrypt it. Excluding
  the file avoids restoring data that's guaranteed to be unreadable (and would
  otherwise crash SourcesActivity on first open after a restore).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="retrotube_network_shares.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="retrotube_network_shares.xml" />
    </device-transfer>
</data-extraction-rules>
