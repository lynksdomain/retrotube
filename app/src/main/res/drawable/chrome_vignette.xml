<?xml version="1.0" encoding="utf-8"?>
<!-- A subtle, non-interactive darkening at the screen edges, applied over UI chrome
     (not just video playback) as part of the app's retro-premium visual identity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="radial"
        android:gradientRadius="480dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#00000000"
        android:endColor="#3D000000" />
</shape>
